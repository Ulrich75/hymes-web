# ─────────────────────────────────────────────────────────────
# Modèle de configuration — COPIER vers .env puis renseigner.
# Ne JAMAIS mettre de vraies clés ici (ce fichier est suivi par git).
# ─────────────────────────────────────────────────────────────

# ── Supabase (Project Settings ▸ API) ──────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
# Clé secrète serveur uniquement — NE JAMAIS exposer côté client
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ── Postgres (Supabase) pour Prisma — Settings ▸ Database ──────
#  - DATABASE_URL : connexion poolée (pgbouncer, port 6543) pour le runtime
#  - DIRECT_URL   : connexion directe (port 5432) pour les migrations
DATABASE_URL=postgresql://postgres.xxxx:[PASSWORD]@aws-region.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.xxxx:[PASSWORD]@aws-region.pooler.supabase.com:5432/postgres

# ── Admin ──────────────────────────────────────────────────────
# Mot de passe humain pour le login web (/login).
ADMIN_PASSWORD=mon-mot-de-passe
# Jeton Bearer pour l'API (mobile/scripts), jamais tapé à la main.
# Générer un secret : openssl rand -hex 32
ADMIN_TOKEN=change-me-long-random-string
